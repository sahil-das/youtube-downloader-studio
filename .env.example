# YouTube Downloader Studio — Optional Environment Overrides
# Copy to .env only for local development overrides if needed.
# NEVER store passwords, cookies, API keys, or tokens in .env or source control.

# Optional custom directory for application state (settings, SQLite DB, logs)
# Defaults to %LOCALAPPDATA%\YouTubeDownloaderStudio on Windows
# YTD_STUDIO_DATA_DIR=

# Optional default log verbosity (DEBUG, INFO, WARNING, ERROR)
# YTD_STUDIO_LOG_LEVEL=INFO

# Optional explicit path to ffmpeg executable or bin directory
# YTD_STUDIO_FFMPEG_PATH=
